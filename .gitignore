*.local.json
.env
.env.*
ming.local.json

# 系统
Thumbs.db
desktop.ini
.DS_Store
astrbot_plugins/**/__pycache__/

# 测试跑出来的时长采样（>1MB）
dsh-ming-mousepet/test/live-duration-*.json

