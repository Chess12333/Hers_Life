{
  "manifest_version": 3,
  "name": "溟的网页取文",
  "version": "0.4.0",
  "description": "右键「溟：指一段」，光标指到哪块就高亮哪块，点一下交给本机桌宠；选中文字右键也能交。只发到 127.0.0.1。",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:51557/*",
    "http://127.0.0.1:47322/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
